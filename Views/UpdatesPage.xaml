<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Mystical.WinUI.Views.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="20">
        <StackPanel Spacing="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource MysticalTitleStyle}" Text="Updates" />
                    <TextBlock
                        Style="{StaticResource MysticalSubtleTextStyle}"
                        Text="Check installed games for pending launcher updates." />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="Check Now" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="2"
                    Click="OnHelpTopicClicked"
                    Style="{StaticResource MysticalInfoIconButtonStyle}"
                    Tag="updates"
                    ToolTipService.ToolTip="Updates help"
                    VerticalAlignment="Center"
                    Margin="8,0,0,0">
                    <FontIcon Glyph="&#xE946;" />
                </Button>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressRing Height="18" Width="18" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            </StackPanel>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MysticalGameListCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="Installed checked" />
                        <TextBlock FontFamily="Segoe UI Variable Display" FontSize="24" Text="{x:Bind ViewModel.InstalledGamesChecked, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource MysticalGameListCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="Updates found" />
                        <TextBlock FontFamily="Segoe UI Variable Display" FontSize="24" Text="{x:Bind ViewModel.UpdatesFound, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MysticalGameListCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="Last checked" />
                        <TextBlock FontFamily="Segoe UI Variable Display" FontSize="20" Text="{x:Bind ViewModel.LastCheckedText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                Visibility="{x:Bind ViewModel.NotesVisibility, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock FontFamily="Segoe UI Variable Display" FontSize="18" Text="Notes" />
                    <ItemsControl x:Name="NotesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="WrapWholeWords" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">
                <StackPanel Spacing="10">
                    <TextBlock FontFamily="Segoe UI Variable Display" FontSize="20" Text="Games Requiring Update" />
                    <ListView x:Name="UpdateItemsListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource MysticalGameListCardBorderStyle}" Margin="0,3">
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource MysticalSubtleTextStyle}" Text="{Binding PlatformName}" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="{Binding Details}" TextWrapping="WrapWholeWords" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="{Binding CurrentVersionLabel}" />
                                            <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="{Binding LatestVersionLabel}" />
                                            <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="{Binding Source}" />
                                        </StackPanel>
                                        <Button
                                            Click="OnInstallUpdateClicked"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource MysticalToolbarButtonStyle}"
                                            Tag="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <SymbolIcon Symbol="Download" />
                                                <TextBlock Text="Update" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="14"
                Padding="22"
                HorizontalAlignment="Center"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                <StackPanel MaxWidth="420" Spacing="8">
                    <FontIcon
                        FontSize="36"
                        Glyph="&#xE7BA;"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        FontFamily="Segoe UI Variable Display"
                        FontSize="20"
                        Text="No updates detected"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Style="{StaticResource MysticalSubtleTextStyle}"
                        Text="Checked launchers did not report pending updates."
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
