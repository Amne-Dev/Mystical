<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Mystical.WinUI.Views.DealsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="20">
        <StackPanel Spacing="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource MysticalTitleStyle}" Text="Deals" />
                    <TextBlock
                        Style="{StaticResource MysticalSubtleTextStyle}"
                        Text="Massive discounts across Steam, Epic, and GOG plus free games to claim." />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.RefreshDealsCommand}"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="2"
                    Click="OnHelpTopicClicked"
                    Style="{StaticResource MysticalInfoIconButtonStyle}"
                    Tag="deals"
                    ToolTipService.ToolTip="Deals help"
                    VerticalAlignment="Center"
                    Margin="8,0,0,0">
                    <FontIcon Glyph="&#xE946;" />
                </Button>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressRing Height="18" Width="18" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            </StackPanel>

            <Border
                Visibility="{x:Bind ViewModel.FreeNowVisibility, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">
                <StackPanel Spacing="10">
                    <TextBlock FontFamily="Segoe UI Variable Display" FontSize="20" Text="Free Right Now" />
                    <GridView
                        x:Name="FreeNowGridView"
                        Height="320"
                        IsItemClickEnabled="False"
                        SelectionMode="None"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollMode="Enabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid MaximumRowsOrColumns="1" Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="4" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="230"
                                    MinHeight="250"
                                    Style="{StaticResource MysticalGameListCardBorderStyle}">
                                    <StackPanel Spacing="8">
                                        <Border
                                            Height="130"
                                            CornerRadius="8"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                            <Image Source="{Binding ImageUri}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Text="{Binding Title}"
                                            MaxLines="2"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="{Binding Store}" />
                                        <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="{Binding AvailabilityText}" />
                                        <Button
                                            Click="OnOpenDealClicked"
                                            HorizontalAlignment="Left"
                                            Content="Claim"
                                            Tag="{Binding DealUrl}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </Border>

            <Border
                Visibility="{x:Bind ViewModel.FreeSoonVisibility, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">
                <StackPanel Spacing="10">
                    <TextBlock FontFamily="Segoe UI Variable Display" FontSize="20" Text="Free Soon" />
                    <GridView
                        x:Name="FreeSoonGridView"
                        Height="320"
                        IsItemClickEnabled="False"
                        SelectionMode="None"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollMode="Enabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid MaximumRowsOrColumns="1" Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="4" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="230"
                                    MinHeight="250"
                                    Style="{StaticResource MysticalGameListCardBorderStyle}">
                                    <StackPanel Spacing="8">
                                        <Border
                                            Height="130"
                                            CornerRadius="8"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                            <Image Source="{Binding ImageUri}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Text="{Binding Title}"
                                            MaxLines="2"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="{Binding Store}" />
                                        <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="{Binding AvailabilityText}" />
                                        <Button
                                            Click="OnOpenDealClicked"
                                            HorizontalAlignment="Left"
                                            Content="Open"
                                            Tag="{Binding DealUrl}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </Border>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">
                <StackPanel Spacing="10">
                    <TextBlock FontFamily="Segoe UI Variable Display" FontSize="20" Text="Massive Discounts" />
                    <ListView x:Name="MassiveDiscountListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="94" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="84"
                                        Height="48"
                                        CornerRadius="6"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <Image Source="{Binding ImageUri}" Stretch="UniformToFill" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="{Binding Store}" />
                                        <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="{Binding PriceText}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="4">
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding SavingsText}" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        <Button
                                            Click="OnOpenDealClicked"
                                            Content="Open"
                                            Tag="{Binding DealUrl}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
