<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Mystical.WinUI.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                Grid.Column="0"
                Height="36"
                PlaceholderText="Search title or description"
                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                VerticalAlignment="Center">
                <AutoSuggestBox.QueryIcon>
                    <SymbolIcon Symbol="Find" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>

            <ComboBox
                Grid.Column="1"
                Height="36"
                ItemsSource="{Binding PlatformFilters}"
                PlaceholderText="Platform"
                SelectedItem="{Binding SelectedPlatform, Mode=TwoWay}"
                VerticalAlignment="Center" />

            <ComboBox
                Grid.Column="2"
                Height="36"
                ItemsSource="{Binding LibraryFilters}"
                PlaceholderText="Filter"
                SelectedItem="{Binding SelectedLibraryFilter, Mode=TwoWay}"
                VerticalAlignment="Center" />

            <Button
                Grid.Column="3"
                Command="{Binding RefreshCommand}"
                Style="{StaticResource MysticalToolbarButtonStyle}"
                VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="4"
                Command="{Binding LaunchSelectedCommand}"
                IsEnabled="{Binding HasSelection}"
                Style="{StaticResource MysticalToolbarButtonStyle}"
                VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" />
                    <TextBlock Text="{Binding PrimaryActionText}" />
                </StackPanel>
            </Button>

            <StackPanel
                Grid.Column="5"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center">
                <ToggleButton
                    IsChecked="{Binding IsGridViewSelected, Mode=TwoWay}"
                    Style="{StaticResource MysticalViewModeToggleStyle}"
                    ToolTipService.ToolTip="Grid view">
                    <SymbolIcon Symbol="AllApps" />
                </ToggleButton>
                <ToggleButton
                    IsChecked="{Binding IsListViewSelected, Mode=TwoWay}"
                    Style="{StaticResource MysticalViewModeToggleStyle}"
                    ToolTipService.ToolTip="List view">
                    <SymbolIcon Symbol="Bullets" />
                </ToggleButton>
            </StackPanel>

            <Button
                Grid.Column="6"
                Click="OnHelpTopicClicked"
                Style="{StaticResource MysticalInfoIconButtonStyle}"
                Tag="library-usage"
                ToolTipService.ToolTip="Library help"
                VerticalAlignment="Center">
                <FontIcon Glyph="&#xE946;" />
            </Button>
        </Grid>

        <Border
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="12,10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressRing
                    Height="18"
                    IsActive="{Binding IsScanning}"
                    VerticalAlignment="Center"
                    Width="18" />

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding StatusMessage}" />
                    <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="{Binding SelectedGameSubtitle}" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    Command="{Binding ToggleFavoriteCommand}"
                    IsEnabled="{Binding HasSelection}"
                    Style="{StaticResource MysticalToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE734;" />
                        <TextBlock Text="Favorite" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="3"
                    Click="OnImportCoverClicked"
                    IsEnabled="{Binding HasSelection}"
                    Style="{StaticResource MysticalToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE898;" />
                        <TextBlock Text="Import Cover" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <GridView
                HorizontalAlignment="Stretch"
                IsItemClickEnabled="False"
                ItemsSource="{Binding Games}"
                SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                SelectionMode="Single"
                Visibility="{Binding GridViewVisibility}"
                VerticalAlignment="Stretch">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid MaximumRowsOrColumns="5" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </GridView.ItemContainerTransitions>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Style="{StaticResource MysticalGameCardBorderStyle}"
                            Width="236"
                            DoubleTapped="OnGameCardDoubleTapped">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="OnContextToggleFavoriteClicked"
                                        Tag="{Binding}"
                                        Text="Toggle favorite">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Favorite" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Click="OnContextRefreshCoverClicked"
                                        Tag="{Binding}"
                                        Text="Refresh cover art">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Refresh" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <StackPanel Spacing="8">
                                <Border
                                    Height="300"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                    <Grid>
                                        <FontIcon
                                            FontSize="28"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE7FC;"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <Image
                                            Source="{Binding CoverArtUri}"
                                            HorizontalAlignment="Stretch"
                                            Stretch="UniformToFill"
                                            VerticalAlignment="Stretch" />
                                    </Grid>
                                </Border>

                                <TextBlock
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="{Binding PlatformName}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding FavoriteGlyph}" />
                                </Grid>

                                <TextBlock
                                    MaxLines="2"
                                    Style="{StaticResource MysticalSubtleTextStyle}"
                                    Text="{Binding Description}"
                                    TextTrimming="WordEllipsis" />

                                <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="{Binding FormattedPlaytime}" />
                                <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="{Binding FormattedSize}" />
                                <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="{Binding InstallStateText}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <ListView
                HorizontalAlignment="Stretch"
                IsItemClickEnabled="False"
                ItemsSource="{Binding Games}"
                Padding="0"
                SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                SelectionMode="Single"
                Visibility="{Binding ListViewVisibility}"
                VerticalAlignment="Stretch">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Style="{StaticResource MysticalGameListCardBorderStyle}"
                            HorizontalAlignment="Stretch"
                            DoubleTapped="OnGameCardDoubleTapped">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="OnContextToggleFavoriteClicked"
                                        Tag="{Binding}"
                                        Text="Toggle favorite">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Favorite" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Click="OnContextRefreshCoverClicked"
                                        Tag="{Binding}"
                                        Text="Refresh cover art">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Refresh" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="56"
                                    Height="84"
                                    CornerRadius="8"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <Grid>
                                        <FontIcon
                                            FontSize="24"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE7FC;"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <Image
                                            Source="{Binding CoverArtUri}"
                                            HorizontalAlignment="Stretch"
                                            Stretch="UniformToFill"
                                            VerticalAlignment="Stretch" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock
                                        FontFamily="Segoe UI Variable Display"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="{Binding Description}" TextTrimming="WordEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="{Binding PlatformName}" />
                                        <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="{Binding InstallStateText}" />
                                        <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="{Binding FormattedPlaytime}" />
                                        <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="{Binding FormattedSize}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Top"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding FavoriteGlyph}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="14"
                Padding="26"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Visibility="{Binding EmptyStateVisibility}">
                <StackPanel MaxWidth="380" Spacing="10">
                    <FontIcon
                        FontSize="44"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE7FC;"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        FontFamily="Segoe UI Variable Display"
                        FontSize="20"
                        HorizontalAlignment="Center"
                        Text="No games in this view" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource MysticalSubtleTextStyle}"
                        Text="Run a full refresh or adjust filters to populate your library."
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                    <Button
                        HorizontalAlignment="Center"
                        Command="{Binding RefreshCommand}"
                        Content="Scan Launchers" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
