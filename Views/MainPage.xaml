<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Mystical.WinUI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="CustomTitleBar"
            Grid.Row="0"
            Background="Transparent"
            Padding="12,0,138,0">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7FC;" />
                <TextBlock
                    FontFamily="Segoe UI Variable Display"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="Mystical" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="AppNavigationView"
            Grid.Row="1"
            IsBackEnabled="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="LibraryNavigationItem"
                    Content="Library"
                    Tag="library">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="DealsNavigationItem"
                    Content="Deals"
                    Tag="deals">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Shop" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="UpdatesNavigationItem"
                    Content="Updates"
                    Tag="updates">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Sync" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="StatsNavigationItem"
                    Content="Stats"
                    Tag="stats">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="BrowsePhotos" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="HelpNavigationItem"
                    Content="Help"
                    Tag="help">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Page>
