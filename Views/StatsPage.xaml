<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Mystical.WinUI.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="20">
        <StackPanel Spacing="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource MysticalTitleStyle}" Text="Stats" />
                    <TextBlock
                        Style="{StaticResource MysticalSubtleTextStyle}"
                        Text="Overview of your local and linked game library." />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Command="{Binding RefreshCommand}"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="2"
                    Click="OnHelpTopicClicked"
                    Style="{StaticResource MysticalInfoIconButtonStyle}"
                    Tag="stats"
                    ToolTipService.ToolTip="Stats help"
                    VerticalAlignment="Center"
                    Margin="8,0,0,0">
                    <FontIcon Glyph="&#xE946;" />
                </Button>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressRing Height="18" Width="18" IsActive="{Binding IsLoading}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding StatusMessage}" />
            </StackPanel>

            <Grid ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource MysticalGameListCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="Total games" />
                        <TextBlock FontFamily="Segoe UI Variable Display" FontSize="30" Text="{Binding TotalGames}" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource MysticalGameListCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="Installed" />
                        <TextBlock FontFamily="Segoe UI Variable Display" FontSize="30" Text="{Binding InstalledGames}" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource MysticalGameListCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="Not installed" />
                        <TextBlock FontFamily="Segoe UI Variable Display" FontSize="30" Text="{Binding NotInstalledGames}" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource MysticalGameListCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="Favorites" />
                        <TextBlock FontFamily="Segoe UI Variable Display" FontSize="30" Text="{Binding FavoriteGames}" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="2"
                    Grid.Column="0"
                    Style="{StaticResource MysticalGameListCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="Total size" />
                        <TextBlock FontFamily="Segoe UI Variable Display" FontSize="22" Text="{Binding TotalSizeText}" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="2"
                    Grid.Column="1"
                    Style="{StaticResource MysticalGameListCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="Most played" />
                        <TextBlock FontFamily="Segoe UI Variable Display" FontSize="18" Text="{Binding MostPlayedText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource MysticalGameListCardBorderStyle}">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="Total play time" />
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE946;"
                                ToolTipService.ToolTip="{Binding TotalPlaytimeInfoText}" />
                        </StackPanel>
                        <TextBlock FontFamily="Segoe UI Variable Display" FontSize="26" Text="{Binding TotalPlaytimeText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock FontFamily="Segoe UI Variable Display" FontSize="20" Text="Platforms" />
                    <ListView ItemsSource="{Binding PlatformBreakdown}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Platform}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        Text="{Binding Count}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock FontFamily="Segoe UI Variable Display" FontSize="20" Text="Games Played Activity" />
                        <TextBlock
                            Style="{StaticResource MysticalSubtleTextStyle}"
                            Text="{Binding GamesActivitySummaryText}" />

                        <GridView
                            IsItemClickEnabled="False"
                            IsTabStop="False"
                            ItemsSource="{Binding GamesActivityCells}"
                            SelectionMode="None"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.HorizontalScrollMode="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid MaximumRowsOrColumns="7" Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="11"
                                        Height="11"
                                        Margin="2"
                                        CornerRadius="2"
                                        Background="{StaticResource MysticalAccentBrush}"
                                        Opacity="{Binding HeatOpacity}"
                                        ToolTipService.ToolTip="{Binding TooltipText}" />
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="Less" />
                            <Border Width="11" Height="11" CornerRadius="2" Background="{StaticResource MysticalAccentBrush}" Opacity="0.12" />
                            <Border Width="11" Height="11" CornerRadius="2" Background="{StaticResource MysticalAccentBrush}" Opacity="0.35" />
                            <Border Width="11" Height="11" CornerRadius="2" Background="{StaticResource MysticalAccentBrush}" Opacity="0.58" />
                            <Border Width="11" Height="11" CornerRadius="2" Background="{StaticResource MysticalAccentBrush}" Opacity="0.82" />
                            <Border Width="11" Height="11" CornerRadius="2" Background="{StaticResource MysticalAccentBrush}" Opacity="1.0" />
                            <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="More" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock FontFamily="Segoe UI Variable Display" FontSize="20" Text="Playtime Activity" />
                        <TextBlock
                            Style="{StaticResource MysticalSubtleTextStyle}"
                            Text="{Binding TimeActivitySummaryText}" />

                        <GridView
                            IsItemClickEnabled="False"
                            IsTabStop="False"
                            ItemsSource="{Binding TimeActivityCells}"
                            SelectionMode="None"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.HorizontalScrollMode="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid MaximumRowsOrColumns="7" Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="11"
                                        Height="11"
                                        Margin="2"
                                        CornerRadius="2"
                                        Background="{StaticResource MysticalAccentBrush}"
                                        Opacity="{Binding HeatOpacity}"
                                        ToolTipService.ToolTip="{Binding TooltipText}" />
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="Less" />
                            <Border Width="11" Height="11" CornerRadius="2" Background="{StaticResource MysticalAccentBrush}" Opacity="0.12" />
                            <Border Width="11" Height="11" CornerRadius="2" Background="{StaticResource MysticalAccentBrush}" Opacity="0.35" />
                            <Border Width="11" Height="11" CornerRadius="2" Background="{StaticResource MysticalAccentBrush}" Opacity="0.58" />
                            <Border Width="11" Height="11" CornerRadius="2" Background="{StaticResource MysticalAccentBrush}" Opacity="0.82" />
                            <Border Width="11" Height="11" CornerRadius="2" Background="{StaticResource MysticalAccentBrush}" Opacity="1.0" />
                            <TextBlock Style="{StaticResource MysticalSubtleTextStyle}" Text="More" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
