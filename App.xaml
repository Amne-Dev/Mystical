<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="Mystical.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="MysticalAccentColor">#0A7AD6</Color>
            <SolidColorBrush x:Key="MysticalAccentBrush" Color="{StaticResource MysticalAccentColor}" />

            <x:Double x:Key="AppSpacing">10</x:Double>
            <x:Double x:Key="AppCornerRadius">14</x:Double>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            </Style>

            <Style x:Key="MysticalTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="MysticalSubtleTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="MysticalGameCardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Margin" Value="6" />
                <Setter Property="MinHeight" Value="270" />
            </Style>

            <Style x:Key="MysticalGameListCardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Margin" Value="2,2,2,4" />
            </Style>

            <Style x:Key="MysticalToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="MysticalViewModeToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="MinWidth" Value="34" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="MysticalInfoIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="MinWidth" Value="30" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="15" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
